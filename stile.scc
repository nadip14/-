/* Основные настройки */
body {
    margin: 0;
    padding: 0;
    background-color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    color: #222;
}

/* Контейнер статьи */
.zen-article {
    max-width: 700px; /* Идеальная ширина для чтения */
    margin: 0 auto;
    padding: 40px 20px;
}

/* Заголовок */
.zen-title {
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    margin-bottom: 12px;
}

.zen-meta {
    font-size: 14px;
    color: #777;
    margin-bottom: 30px;
}

.zen-meta .dot { margin: 0 8px; }

/* Изображения */
.zen-main-image {
    margin: 0 -20px 30px -20px; /* Вылет картинки за пределы текста */
}

.zen-main-image img {
    width: 100%;
    height: auto;
    display: block;
}

.zen-main-image figcaption {
    font-size: 14px;
    color: #999;
    text-align: center;
    margin-top: 10px;
}

/* Текстовый блок */
.zen-content p {
    font-size: 19px;
    margin-bottom: 24px;
    letter-spacing: -0.01em;
}

.zen-content h2 {
    font-size: 28px;
    margin: 40px 0 20px;
}

/* Цитаты */
blockquote {
    border-left: 4px solid #000;
    padding-left: 20px;
    margin: 30px 0;
    font-style: italic;
    font-size: 22px;
    color: #444;
}

/* Списки */
ul {
    margin-bottom: 24px;
    padding-left: 20px;
}

ul li {
    margin-bottom: 10px;
    font-size: 19px;
}
